# Treningsanalyse Backend Environment Variables
# Kopier denne filen til .env og fyll inn dine verdier

# Database Configuration
# Anbefalt: la DATABASE_URL stå tom for å bruke prosjektets standard (backend/data/treningsanalyse.db).
# Hvis du overstyrer, bruk absolutt sti for portabilitet, f.eks.:
# DATABASE_URL=sqlite:////absolutt/sti/til/backend/data/treningsanalyse.db
# DATABASE_URL=

# Garmin Connect Credentials
# PÅKREVD: Dine Garmin Connect innloggingsdetaljer
# Innlogging og token-fornyelse går via python-garminconnect (ikke garth).
GARMIN_EMAIL=din.epost@example.com
GARMIN_PASSWORD=ditt_passord_her

# Valgfritt: eksplisitt sti til garminconnect token-cache (garmin_tokens.json).
# Tom => <TOKEN_DIR>/garmin_tokens.json. En eksisterende garth oauth2_token.json
# i TOKEN_DIR migreres automatisk inn i denne cachen én gang (legacy fallback).
# GARMIN_TOKEN_FILE=

# Valgfritt: sett til true for kinesiske Garmin-kontoer (garmin.cn)
# GARMIN_IS_CN=false

# Token Storage Directory
# Valgfritt. Hvis tom/utelatt brukes standard token-mappe under backend.
# Anbefalt: bruk absolutt sti ved overstyring.
# TOKEN_DIR=

# Data Storage Directory
# Valgfritt. Hvis tom/utelatt brukes standard backend/data.
# Anbefalt: bruk absolutt sti ved overstyring.
# DATA_DIR=

# Desktop / portable root (Electron AppData). When set, DATA_DIR/TOKEN_DIR/FIT/cache/logs/backups
# are derived under this folder unless explicitly overridden.
# TRAININGSANALYSE_DATA_DIR=
# FIT_DATA_DIR=
# CACHE_DIR=
# LOG_DIR=
# BACKUP_DIR=
# EXPORT_DIR=
# DESKTOP_MODE=false

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS — komma-separert liste over tillatte frontend-origins
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hopp over Garmin-innlogging ved API-oppstart (anbefalt i lokal dev)
SKIP_GARMIN_INIT=true

# Redis (valgfritt — raskere cache; uten Redis brukes in-memory)
# Start lokalt: docker run -d --name treningsanalyse-redis -p 6379:6379 redis:7-alpine
# eller: docker compose --profile redis up -d redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Runtime profile
ENVIRONMENT=local
DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1

# Vær på aktiviteter
# MET User-Agent (påkrevd av api.met.no) — locationforecast dekker kun fremtid
MET_API_USER_AGENT=Treningsanalyse/1.0 (din@epost.example)

# Frost API for historisk temperatur/vind (anbefalt for norske økter)
# https://frost.met.no/auth/requestCredentials.html
# Uten FROST lagres temperatur fra Garmin (min/max på activitylist), ikke vind fra API.
FROST_CLIENT_ID=

# Telegram-varsling — varsler når Garmin krever ny innlogging/MFA under synk.
# Opprett en bot hos @BotFather og hent chat_id (f.eks. via @userinfobot).
# Uten disse er varsling deaktivert (synk fungerer fortsatt, men varsler ikke).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum sekunder mellom identiske re-auth-varsler (unngår spam).
TELEGRAM_REAUTH_COOLDOWN_SECONDS=1800

# Optional: Lactate Threshold Speed (m/s)
# LACTATE_THRESHOLD_SPEED=3.1056

# Valgfritt løpsmål for Adaptive Coaching Engine v4 (konfigurasjon, ikke DB)
# ATHLETE_GOAL_TYPE=race
# ATHLETE_GOAL_EVENT=half_marathon
# ATHLETE_GOAL_TARGET_DATE=2026-10-18
# ATHLETE_GOAL_TARGET_TIME_SEC=6300
# ATHLETE_GOAL_PRIORITY=A












